# Supabase (create project at https://supabase.com/dashboard)
# Copy this file to .env and fill in the values after Step 1.

# Frontend (Vite) - use anon key (public, safe in browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (Node/Express) - use service_role key (secret, server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
